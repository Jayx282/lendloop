# ---------------------------------------------------------------------------
# Convex-only secrets. Copy to .env.convex (gitignored), or let `npm run setup`
# generate it. setup copies these into the Convex deployment's environment.
# ---------------------------------------------------------------------------

# Master key for field-level encryption of personal data (emails): 32 random
# bytes, base64. `openssl rand -base64 32`. Losing it makes stored emails unreadable.
LENDLOOP_DATA_KEY=

# Only during a key rotation: the old key, so existing values stay readable until
# `npx convex run security:reencryptEmails` has moved them to the new key.
LENDLOOP_DATA_KEY_PREVIOUS=
