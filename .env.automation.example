# ---------------------------------------------------------------------------
# Shared signing secrets for the Convex <-> n8n integration.
# Copy to .env.automation (gitignored), or let `npm run setup` generate it.
#
# Each direction has its own secret, so a leak on one side cannot be used
# to forge traffic in the other direction.
#   - Convex reads both from its environment (`npx convex env set`, done by setup).
#   - n8n never sees these as environment variables: the one-shot `n8n-import`
#     container turns them into encrypted n8n credentials and exits.
# Use at least 32 random bytes: `openssl rand -hex 32`
# ---------------------------------------------------------------------------

# Convex signs loan-event webhooks (HS256 JWT); n8n verifies them.
CONVEX_TO_N8N_SIGNING_SECRET=

# n8n signs its calls to the Convex HTTP endpoints (HS256 JWT); Convex verifies them.
N8N_TO_CONVEX_SIGNING_SECRET=
