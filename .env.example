# ---------------------------------------------------------------------------
# Next.js app settings. Copy to .env.local (gitignored) and fill in.
# Only NEXT_PUBLIC_* values are sent to the browser.
# ---------------------------------------------------------------------------

# Clerk (Dashboard -> API keys). Development instance keys start with pk_test_ / sk_test_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk Frontend API URL, shown after "Activate Convex integration"
# (https://dashboard.clerk.com/apps/setup/convex). `npm run setup` copies it
# into the Convex deployment, which uses it to verify Clerk session tokens.
CLERK_FRONTEND_API_URL=https://your-app-00.clerk.accounts.dev

# Never let Clerk auto-provision a throwaway "keyless" application.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=1

# Convex. The default is the self-hosted backend from docker-compose.yml.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# Written by `npm run setup` (docker compose exec convex-backend ./generate_admin_key.sh).
CONVEX_SELF_HOSTED_ADMIN_KEY=
